<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Helpdesk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
  </head>

  <body data-controller="shortcuts">
    <%= torque_lift_analytics(user_id: Current.user&.id, consent: true) %>
    <% if authenticated? %>
      <div class="app">
        <%= render "layouts/sidebar" %>
        <div class="app-main">
          <% if content_for?(:workspace) %>
            <%= render "shared/flash" %>
            <%= yield %>
          <% else %>
            <main class="page">
              <%= render "shared/flash" %>
              <%= yield %>
            </main>
          <% end %>
        </div>
      </div>
    <% else %>
      <main class="auth">
        <div class="auth-card">
          <div class="brand"><span class="brand-mark">H</span> Helpdesk</div>
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
